FAL_KEY=your_fal_ai_key_here
# FAL_KEY powers natural MiniMax voices and voice cloning (upload sample -> speak your script)

# Hugging Face — rewrite, transcription, slide scripts
# Create token at https://huggingface.co/settings/tokens with:
#   "Make calls to Inference Providers" enabled (required for chat/rewrite)
HF_API_TOKEN=your_huggingface_token_here
HUGGINGFACE_TOKEN=your_huggingface_token_here
HF_REWRITE_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
HF_SLIDE_SCRIPT_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
REWRITE_PROVIDER_ORDER=huggingface,groq,rules
SLIDE_SCRIPT_PROVIDER_ORDER=groq,fal,huggingface,rules
HF_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo

# Local dev only: copy to .env.local (never commit .env.local)
# Push to Vercel: npm run vercel:env

# Optional: local Ollama (free, no API key)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Groq free tier (recommended for slide scripts if HF token lacks Inference Providers)
# https://console.groq.com — then: npm run vercel:env && vercel --prod
GROQ_API_KEY=your_groq_api_key_here
GROQ_REWRITE_MODEL=llama-3.3-70b-versatile
GROQ_SLIDE_SCRIPT_MODEL=llama-3.3-70b-versatile
